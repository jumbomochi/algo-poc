# Copy this file to `.env` (gitignored) and fill in real values.
# `docker compose` reads `.env` automatically from the project root and
# substitutes `${VAR}` references in docker-compose.yml — no extra flags
# needed. NEVER commit `.env`.
#
#   cp .env.example .env
#   # then edit .env with real values

# --- Message-bus / DB credentials (REQUIRED) ---------------------------
# docker-compose.yml refuses to render (and `docker compose up` fails before
# any container starts) if these are unset or empty. Generate strong,
# unique values — do not reuse across environments:
#   openssl rand -hex 24
#
# NOTE on rotating an EXISTING Postgres volume: Postgres only applies
# POSTGRES_PASSWORD on first volume init. If you already have a `pgdata`
# volume from before this password was required, setting it here does NOT
# change the running database's password — you must also run, once, against
# the live container:
#   docker compose exec postgres psql -U algo -d algo_poc \
#     -c "ALTER USER algo WITH PASSWORD '<the same value you put below>';"
# (See docker-compose.override.yml.example for the full operator runbook.)
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Observability overlay (REQUIRED for docker-compose.observability.yml) --
# Only needed when you start the stack with
#   docker compose -f docker-compose.yml -f docker-compose.observability.yml up
# but documented here rather than in a second file so that command renders
# from this one `.env`. Grafana refuses to start without it (the overlay
# previously shipped a committed admin/admin, which is why there is no
# default). Generate one: `openssl rand -hex 24`.
GRAFANA_ADMIN_PASSWORD=

# --- Optional integrations (safe to leave blank in paper/dev mode) -----

# Telegram alerting (deploy/launchd/gateway_watchdog.sh, notifications
# service, and — separately from both — the Alertmanager container in
# docker-compose.observability.yml).
#
# Alertmanager is the ONE alert path that does not run through the
# notifications service, because HeartbeatStale exists to detect a wedged
# notifications service and a monitor must not die with its subject. If you
# leave these blank the rest of the stack still starts normally; the
# alertmanager container refuses to start with a named error instead of
# coming up as a silent monitor.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API bearer keys for services/api, format "key1:role1,key2:role2" with
# role in admin|operator|viewer. Unset falls back to dev-only keys, which
# services/api/auth.py refuses to start with when ALGO_MODE=live.
API_KEYS=

# Host directory shared between the execution container and the host-side
# IB Gateway watchdog for the Error-1100 marker file. Defaults to
# ~/ibc/state if unset — only set this if that default is wrong for your
# machine.
ALGO_GATEWAY_STATE_DIR_HOST=
