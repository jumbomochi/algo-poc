<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Disabled</key>
	<false/>
	<key>Label</key>
	<string>local.algo-earnings-refresh</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/huiliang/ibc/run_earnings_refresh.sh</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Users/huiliang/ibc/logs/earnings-refresh-launchd.log</string>
	<key>StandardOutPath</key>
	<string>/Users/huiliang/ibc/logs/earnings-refresh-launchd.log</string>
	<!-- 04:45 SGT EVERY day (KAN-110). Daily including weekends because KAN-109
	     degrades earnings_drift once earnings.json is 2 days old; a Tue-Sat job
	     would leave Tuesday's paper run on a Saturday fetch. 04:45 is the US
	     afternoon (16:45 EDT / 15:45 EST) of the session the 05:15 paper run
	     prices, so that session's pre-market actuals reach the paper run on
	     their report date, and the previous evening's post-market actuals are
	     a day old. Ahead of the whole KAN-104 chain, and it uses neither IB nor
	     the database. Bounded at 15 min, so it ends before the 05:05 top-up
	     (local.algo-earnings-topup), which catches the after-market reports
	     04:45 is too early for. Rationale in full: run_earnings_refresh.sh. -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>4</integer>
		<key>Minute</key>
		<integer>45</integer>
	</dict>
</dict>
</plist>
