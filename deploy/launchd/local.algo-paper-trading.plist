<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Disabled</key>
	<false/>
	<key>Label</key>
	<string>local.algo-paper-trading</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/huiliang/ibc/run_paper.sh</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Users/huiliang/ibc/logs/paper-launchd.log</string>
	<key>StandardOutPath</key>
	<string>/Users/huiliang/ibc/logs/paper-launchd.log</string>
	<!-- Run at 05:15 SGT Tue-Sat, after the US close in both seasons (KAN-104):
	     = 17:15 ET Mon-Fri under EDT (close 04:00 SGT) and 16:15 ET under EST
	     (close 05:00 SGT). SGT has no DST, so the old 04:15 slot fell 45 min
	     BEFORE the close every EST winter. scripts/run_paper.py refuses to
	     price an unclosed session regardless; this slot just avoids tripping it. -->
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>5</integer>
			<key>Minute</key>
			<integer>15</integer>
			<key>Weekday</key>
			<integer>2</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>5</integer>
			<key>Minute</key>
			<integer>15</integer>
			<key>Weekday</key>
			<integer>3</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>5</integer>
			<key>Minute</key>
			<integer>15</integer>
			<key>Weekday</key>
			<integer>4</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>5</integer>
			<key>Minute</key>
			<integer>15</integer>
			<key>Weekday</key>
			<integer>5</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>5</integer>
			<key>Minute</key>
			<integer>15</integer>
			<key>Weekday</key>
			<integer>6</integer>
		</dict>
	</array>
</dict>
</plist>
